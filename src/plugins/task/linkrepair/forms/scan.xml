<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="params">
		<fieldset name="task_params">
			<field
				name="site_url"
				type="url"
				label="PLG_TASK_LINKREPAIR_FIELD_SITE_URL_LABEL"
				description="PLG_TASK_LINKREPAIR_FIELD_SITE_URL_DESC"
				required="true"
				validate="url"
				filter="url"
				hint="https://www.example.org"
			/>
			<field
				name="other_hosts"
				type="textarea"
				label="PLG_TASK_LINKREPAIR_FIELD_OTHER_HOSTS_LABEL"
				description="PLG_TASK_LINKREPAIR_FIELD_OTHER_HOSTS_DESC"
				rows="3"
				filter="string"
			/>
			<field
				name="follow_redirects"
				type="radio"
				layout="joomla.form.field.radio.switcher"
				label="PLG_TASK_LINKREPAIR_FIELD_FOLLOW_REDIRECTS_LABEL"
				description="PLG_TASK_LINKREPAIR_FIELD_FOLLOW_REDIRECTS_DESC"
				default="1"
				filter="integer"
				>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field
				name="time_budget"
				type="number"
				label="PLG_TASK_LINKREPAIR_FIELD_TIME_BUDGET_LABEL"
				description="PLG_TASK_LINKREPAIR_FIELD_TIME_BUDGET_DESC"
				default="20"
				min="5"
				max="300"
				step="1"
				filter="int"
			/>
		</fieldset>
	</fields>
</form>
