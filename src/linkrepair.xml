<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="task" method="upgrade">
	<name>plg_task_linkrepair</name>
	<author>Herman Peeren</author>
	<creationDate>2026-10</creationDate>
	<copyright>Copyright (C) 2026 Yepr, Herman Peeren. All rights reserved.</copyright>
	<license>GNU General Public License version 3 or later; see LICENSE.txt</license>
	<authorEmail>herman@yepr.nl</authorEmail>
	<authorUrl>https://yepr.nl</authorUrl>
	<version>0.1.0</version>
	<description>PLG_TASK_LINKREPAIR_XML_DESCRIPTION</description>
	<namespace path="src">Yepr\Plugin\Task\LinkRepair</namespace>
	<scriptfile>script.php</scriptfile>

	<files folder="plugins/task/linkrepair">
		<folder plugin="linkrepair">services</folder>
		<folder>forms</folder>
		<folder>language</folder>
		<folder>sql</folder>
		<folder>src</folder>
	</files>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>
	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>
</extension>
